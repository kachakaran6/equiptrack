NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# PostgreSQL Connection URL (managed separately in Coolify)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/equiptrack

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-change-this
JWT_EXPIRES_IN=365d

# CORS Origins (comma-separated, or * for development only)
CORS_ORIGINS=https://your-app.example.com

# ──────────────────────────────────────────────
# Telegram Backup (Required for Telegram backups)
# Get bot token from @BotFather on Telegram
# Get chat ID from @userinfobot or your group ID
# ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ──────────────────────────────────────────────
# Backup Configuration (can also be managed via /api/admin/backup/config)
# ──────────────────────────────────────────────
BACKUP_ENABLED=true
BACKUP_CRON=0 2 * * *
BACKUP_TIMEZONE=Asia/Kolkata
BACKUP_FORMAT=sql
BACKUP_COMPRESSION=gzip
BACKUP_RETENTION_DAYS=30
