NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL Connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/equiptrack

# JWT Secret Keys
JWT_SECRET=your-super-secret-jwt-key-min-32-characters
JWT_EXPIRES_IN=365d

# CORS Allowed Origins (comma separated, or * for all during dev)
CORS_ORIGINS=*
