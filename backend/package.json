{
  "name": "equiptrack-backend",
  "version": "1.0.0",
  "description": "Lightweight, secure Fastify + PostgreSQL backend for EquipTrack",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:supabase": "tsx scripts/migrate-from-supabase/migrate.ts",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^9.0.4",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^10.1.5",
    "archiver": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "csv-stringify": "^6.9.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "node-cron": "^4.6.0",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.10",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
